{
  "name": "@dsh-external/dsh-backup-sync",
  "version": "0.2.0",
  "description": "DSH 备份/恢复插件：整机配置快照（会话/工作区/配置）+ 项目文件快照回滚，支持百度网盘（MCP）/ WebDAV / 仅本地三种目标",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "smoke": "node --experimental-strip-types scripts/smoke.mts",
    "test": "node --experimental-strip-types scripts/smoke.mts"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "backup",
    "snapshot",
    "webdav",
    "baidu-netdisk",
    "sync"
  ],
  "author": "xinglicai",
  "license": "MIT",
  "homepage": "https://github.com/xinglicai/dsh-backup-sync",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinglicai/dsh-backup-sync.git"
  },
  "bugs": {
    "url": "https://github.com/xinglicai/dsh-backup-sync/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-client-runtime": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.7",
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  }
}
